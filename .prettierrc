{
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "next",
    "<THIRD_PARTY_MODULES>",
    "@component",
    "@core",
    "@hooks",
    "@lib",
    "@store",
    "@utils",
    "@styles",
    "@public",
    "@app",
    "^../",
    "^./"
  ],
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "preserve",
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
