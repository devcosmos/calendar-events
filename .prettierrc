{
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": ["^react$", "next", "<THIRD_PARTY_MODULES>", "@component", "@core", "@hooks", "@store", "@utils", "^../", "^./"],
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "preserve",
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
